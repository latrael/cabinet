# Only application sources/manifests enter the image. Libraries, models,
# secrets, screenshots, local dependencies and git history stay on the host.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!LICENSE
!apps/
!apps/*/
!apps/*/package.json
!apps/*/src/
!apps/*/src/**
!apps/web/index.html
!apps/web/vite.config.ts
!apps/web/tsconfig.json
!apps/web/public/
!apps/web/public/**
!packages/
!packages/*/
!packages/*/package.json
!packages/*/src/
!packages/*/src/**
**/.env*
**/.cabinet/**
**/secrets.json
