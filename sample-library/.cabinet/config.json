{
  "version": 1,
  "name": "Sample Cabinet",
  "git": {
    "autoCommit": true,
    "debounceMs": 30000,
    "push": false
  },
  "ai": {
    "provider": "ollama",
    "ollamaUrl": "http://127.0.0.1:11434",
    "chatModel": "qwen3:8b",
    "embedModel": "nomic-embed-text",
    "anthropicModel": "claude-opus-5-5",
    "openaiModel": "gpt-5.1-mini",
    "openaiEmbedModel": "text-embedding-3-small",
    "enrichOnCapture": true,
    "inboxAgent": {
      "enabled": true,
      "intervalMinutes": 360
    }
  },
  "telegram": {
    "enabled": false,
    "allowedChats": []
  },
  "server": {
    "allowRemote": false
  }
}
