# Docker Compose settings only. Native CLI configuration is documented in docs/SETUP.md.
# Defaults keep data outside this source repository. Set absolute host paths.
# CABINET_DATA_DIR=/absolute/path/to/CabinetData
# CABINET_WHISPER_MODELS_DIR=/absolute/path/to/whisper-models
# CABINET_PORT=4747
# On Linux, set these to the output of id -u and id -g to match bind-mount ownership.
# CABINET_UID=1000
# CABINET_GID=1000
