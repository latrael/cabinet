{
  "name": "cabinet",
  "private": true,
  "version": "0.1.0",
  "description": "Personal hobby, research and AI memory hub. Local-first Markdown library.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cabinet/server --filter @cabinet/web dev",
    "build": "pnpm --filter @cabinet/web build",
    "start": "node apps/cli/src/main.ts start",
    "cabinet": "node apps/cli/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p apps/web",
    "lint": "eslint .",
    "sample": "node packages/core/scripts/generate-sample.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
